{{> nurseSidebar}}

<div class="main-content">
  <h5>Карточка пациента: {{patient.full_name}}</h5>

  <form action="/nurse/card/{{patient.card_id}}/status" method="POST" class="mb-2">
    <div class="input-field">
      <select name="status_id">
        {{#each statuses}}
          <option value="{{id}}" {{#if (eq id ../patient.status_id)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select><label>Статус</label>
    </div>
    <button class="btn orange waves-effect">Сохранить</button>
  </form>

  <h6>Записи</h6>
  <ul class="collection">
    {{#each entries}}
      <li class="collection-item">
        <strong>{{entry_date}} {{entry_time}}</strong>: {{note}}
      </li>
    {{/each}}
  </ul>

  <form action="/nurse/card/{{patient.card_id}}/add-entry" method="POST">
    <div class="row">
      <div class="input-field col s4"><input type="date" name="entry_date" required><label class="active">Дата</label></div>
      <div class="input-field col s4"><input type="time" name="entry_time" required><label class="active">Время</label></div>
      <div class="input-field col s12"><textarea name="note" class="materialize-textarea" required></textarea><label>Запись</label></div>
    </div>
    <button class="btn green waves-effect">Добавить запись</button>
  </form>
</div>
